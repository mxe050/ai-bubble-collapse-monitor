# Optional: enables X Recent Search locally. For GitHub Pages, add the same
# name as a GitHub Actions repository secret; never commit the token.
X_BEARER_TOKEN=

# Optional: enables DeepL reference translations. The live refresh must still
# succeed when this is empty. Store the production value only as a GitHub
# Actions repository secret; never expose it to browser JavaScript or JSON.
DEEPL_AUTH_KEY=

# Optional previous public snapshot used to preserve first-seen timestamps and
# avoid presenting a rediscovered article as brand-new.
LIVE_PREVIOUS_URL=https://mxe050.github.io/ai-bubble-collapse-monitor/data/live-intelligence.json
